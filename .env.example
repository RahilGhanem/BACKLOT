# Copy this file to .env and fill in real values. Never commit .env.
# config.py reads everything from the environment — nothing is hardcoded.

# ---------------------------------------------------------------------------
# Gemini model routing (Model Garden). Flash for cheap/high-volume steps,
# Pro for planning-heavy steps (Script Supervisor, Risk/Continuity). Adjust
# the model IDs to whatever is actually available to your key — the code
# never hardcodes a model name, and neither ADK nor this file ever rewrites
# whatever string you put here (verified by tracing .env -> config.py ->
# LlmAgent(model=...) -> google-genai's Models.generate_content, which
# accepts a bare model id like "gemini-3.6-flash" unmodified).
#
# What actually failed here (all reproduced with a raw, ADK-free
# google-genai call against a real AI Studio free-tier key, so this is a
# Google account/model-availability fact, not a bug in this repo):
#   gemini-2.5-flash      -> 404: "no longer available to new users"
#   gemini-2.5-pro        -> 429: quota=0 on the free tier
#   gemini-3-pro-preview  -> 429: quota=0 on the free tier
#   gemini-pro-latest     -> 429: quota=0 on the free tier
#   gemini-3.5-flash      -> 503: transiently overloaded (not account-related)
#   gemini-3.6-flash      -> 200 OK  <- works today on a plain free-tier key
#   gemini-flash-latest   -> 200 OK  <- also works
# No Pro-tier model returned success on a free-tier key when this was
# checked; both roles below point at the same working Flash model until
# billing is enabled on the underlying GCP project (Pro access typically
# unlocks then). List what's available to YOUR key with:
#   python -c "from google import genai; import os; from dotenv import load_dotenv; load_dotenv(); [print(m.name) for m in genai.Client(api_key=os.getenv('GOOGLE_API_KEY')).models.list()]"
# ---------------------------------------------------------------------------
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Generative previz models (Phase 6, opt-in — --with-previz). Real Vertex AI
# access + billing required; Lyria is best-effort, see
# backlot/tools/previz_generation.py.
#
# IMAGEN_MODEL: gemini-2.5-flash-image ("Nano Banana") -- every Imagen 4
# generate-family id (the old default here, imagen-4.0-generate-001) is
# discontinued per Google Cloud's own Vertex AI docs ("Discontinuation
# date: June 30, 2026", already past). Called via a different code path
# than a plain Imagen id (client.interactions.create(), not
# generate_images()) -- see previz_generation.py's generate_storyboards().
# VEO_MODEL: veo-3.1-generate-001 is the current GA id (the previous
# default, veo-3.1-generate-preview, is a deprecated preview endpoint).
# ---------------------------------------------------------------------------
IMAGEN_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-generate-001
LYRIA_MODEL=lyria-3-clip-preview

# ---------------------------------------------------------------------------
# Auth to Gemini — pick ONE path.
#
# Path A (fastest for local dev): an AI Studio API key.
#   GOOGLE_GENAI_USE_ENTERPRISE=FALSE
#   GOOGLE_API_KEY=your-ai-studio-key
#
# Path B (matches the production/Agent Engine deployment): Vertex AI /
# the Gemini Enterprise Agent Platform.
#   GOOGLE_GENAI_USE_ENTERPRISE=TRUE
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   (auth via `gcloud auth application-default login` or a service account)
#
# GOOGLE_GENAI_USE_ENTERPRISE is the current name; the older
# GOOGLE_GENAI_USE_VERTEXAI still works as a fallback (both this file's
# config.py and ADK's own internals read it) but logs a DeprecationWarning
# from inside ADK — set the _ENTERPRISE name to avoid that noise.
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# App identity (used for ADK session service app_name / Agent Engine later)
# ---------------------------------------------------------------------------
BACKLOT_APP_NAME=backlot

# ---------------------------------------------------------------------------
# ClickHouse MCP integration (Phase 3+). MCP_MODE picks which of the two
# blocks below the Budget/Resource agents actually use — see
# backlot/config.py's _resolve_mcp_mode() and
# backlot/agents/_state_instructions.py.
#
#   MCP_MODE=shim        (default) — the local synthetic mcp_shim server.
#                         Nothing else in this section is required.
#   MCP_MODE=clickhouse  — the REAL, official ClickHouse MCP server
#                         (github.com/ClickHouse/mcp-clickhouse), connected
#                         to a ClickHouse Cloud or self-hosted cluster. The
#                         Budget/Resource agents issue real SQL SELECTs (via
#                         that server's run_query/list_tables tools —
#                         verified against mcp-clickhouse's own README's
#                         "MCP Tools" list) against tables loaded by
#                         scripts/clickhouse_load.sql. The studio's
#                         historical cost data lives in ClickHouse; the
#                         Budget agent queries it via this MCP server for
#                         grounded estimates.
# ---------------------------------------------------------------------------
MCP_MODE=shim

# --- shim mode -------------------------------------------------------------
# MCP_SERVER_URL is what the Budget/Resource agents CONNECT to in shim mode.
# MCP_SHIM_HOST/MCP_SHIM_PORT are what the LOCAL mcp_shim SERVER itself
# binds to (only relevant if you're running mcp_shim). Locally these
# describe the same address as MCP_SERVER_URL by default; in a cloud
# deployment they differ — see Dockerfile.mcp_shim and docs/DEPLOYMENT.md.
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_AUTH_TOKEN=
MCP_SHIM_HOST=127.0.0.1
MCP_SHIM_PORT=8765

# --- clickhouse mode ---------------------------------------------------
# Everything below is only read when MCP_MODE=clickhouse. NEVER commit a
# real CLICKHOUSE_MCP_AUTH_TOKEN (or, server-side, a real ClickHouse
# password) — in a cloud deployment the token must come from Secret Manager
# (--set-secrets), never a plain env var; see deploy/cloud_run/deploy.sh
# and docs/DEPLOYMENT.md.
#
# CLICKHOUSE_MCP_URL — the streamable-HTTP URL of a running mcp-clickhouse
#   server. Run it yourself (its README documents both stdio and
#   `--transport http` modes; e.g. `uvx --from mcp-clickhouse mcp-clickhouse
#   --transport http` behind Cloud Run, the same way
#   Dockerfile.mcp_shim/deploy_mcp_shim.sh deploy the shim today). That
#   process needs its OWN env vars set server-side only — see
#   CLICKHOUSE_HOST/PORT/USER/PASSWORD below — never on this BACKLOT
#   deployment itself.
CLICKHOUSE_MCP_URL=
# Bearer token this BACKLOT client sends as `Authorization: Bearer <value>`
# (backlot/agents/_mcp.py) — must match whatever CLICKHOUSE_MCP_AUTH_TOKEN
# the mcp-clickhouse server was started with. Leave blank only if you
# started that server with CLICKHOUSE_MCP_AUTH_DISABLED=true (fine for a
# private network; never for anything internet-reachable).
CLICKHOUSE_MCP_AUTH_TOKEN=
# The database scripts/clickhouse_load.sql loaded data into — must match
# what you used there. Passed to the MCP server's list_tables tool and used
# to qualify every query the Budget/Resource agents issue.
CLICKHOUSE_DATABASE=backlot_studio
#
# --- Reference only: the mcp-clickhouse SERVER's own env vars (set on
# whoever runs that process — a separate Cloud Run service, a container
# next to your cluster, etc. — NEVER read by backlot itself, listed here so
# you know what to set when you stand that server up):
#   CLICKHOUSE_HOST=<your-cluster>.clickhouse.cloud       (or self-hosted host)
#   CLICKHOUSE_PORT=8443                                  (8443 for HTTPS Cloud, 9440 native TLS, 8123 plain HTTP)
#   CLICKHOUSE_USER=<a read-only user, ideally>
#   CLICKHOUSE_PASSWORD=<its password — Secret Manager, never plain env>
#   CLICKHOUSE_SECURE=true                                (TLS — ClickHouse Cloud requires this)
#   CLICKHOUSE_DATABASE=backlot_studio                    (matches this file's CLICKHOUSE_DATABASE above)
#   CLICKHOUSE_MCP_SERVER_TRANSPORT=http
#   CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
#   CLICKHOUSE_MCP_BIND_PORT=$PORT
#   CLICKHOUSE_MCP_AUTH_TOKEN=<same value as this file's CLICKHOUSE_MCP_AUTH_TOKEN>
#   CLICKHOUSE_ALLOW_WRITE_ACCESS unset/false, CLICKHOUSE_ALLOW_DROP unset/false
#     (Budget/Resource only ever SELECT — keep run_query read-only at the
#     server level too, not just by instruction.)

# ---------------------------------------------------------------------------
# Cloud resources (stubbed locally, real once deployed — Phase 7)
# ---------------------------------------------------------------------------
GCS_BUCKET=
FIRESTORE_PROJECT=

# ---------------------------------------------------------------------------
# Local API server (Phase 5 — FastAPI backend + minimal web UI)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
