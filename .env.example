# Copy this file to .env and fill in real values. Never commit .env.
# config.py reads everything from the environment — nothing is hardcoded.

# ---------------------------------------------------------------------------
# Gemini model routing (Model Garden). Flash for cheap/high-volume steps,
# Pro for planning-heavy steps (Line Producer, Risk/Continuity). Adjust the
# model IDs to whatever is actually available in your Model Garden region —
# the code never hardcodes a model name.
# ---------------------------------------------------------------------------
GEMINI_MODEL_FLASH=gemini-3-flash
GEMINI_MODEL_PRO=gemini-3.1-pro

# ---------------------------------------------------------------------------
# Generative previz models (Phase 6, opt-in — --with-previz). Real Vertex AI
# Imagen/Veo access + billing required; Lyria is best-effort, see
# backlot/tools/previz_generation.py.
# ---------------------------------------------------------------------------
IMAGEN_MODEL=imagen-4.0-generate-001
VEO_MODEL=veo-3.1-generate-preview
LYRIA_MODEL=lyria-3-clip-preview

# ---------------------------------------------------------------------------
# Auth to Gemini — pick ONE path.
#
# Path A (fastest for local dev): an AI Studio API key.
#   GOOGLE_GENAI_USE_VERTEXAI=FALSE
#   GOOGLE_API_KEY=your-ai-studio-key
#
# Path B (matches the production/Agent Engine deployment): Vertex AI.
#   GOOGLE_GENAI_USE_VERTEXAI=TRUE
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   (auth via `gcloud auth application-default login` or a service account)
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# App identity (used for ADK session service app_name / Agent Engine later)
# ---------------------------------------------------------------------------
BACKLOT_APP_NAME=backlot

# ---------------------------------------------------------------------------
# IBM MCP integration (Phase 3+).
#
# MCP_SERVER_URL is what the Budget/Resource agents CONNECT to. Points at
# the local synthetic mcp_shim by default. Swapping to the real IBM
# watsonx.data remote MCP server is only an env change: set MCP_SERVER_URL
# to IBM's endpoint and MCP_AUTH_TOKEN to a real credential (never paste
# the token itself into this example file).
#
# MCP_SHIM_HOST/MCP_SHIM_PORT are what the LOCAL mcp_shim SERVER itself
# binds to (only relevant if you're running mcp_shim; irrelevant once
# pointed at the real IBM server). Locally these describe the same address
# as MCP_SERVER_URL by default; in a cloud deployment they differ — see
# Dockerfile.mcp_shim and docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_AUTH_TOKEN=
MCP_SHIM_HOST=127.0.0.1
MCP_SHIM_PORT=8765

# ---------------------------------------------------------------------------
# Cloud resources (stubbed locally, real once deployed — Phase 7)
# ---------------------------------------------------------------------------
GCS_BUCKET=
FIRESTORE_PROJECT=

# ---------------------------------------------------------------------------
# Local API server (Phase 5 — FastAPI backend + minimal web UI)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
